// zero iterations -> else runs
print "T1";
var i = 5;
while (i < 3) {
  print "BAD body";
} else {
  print "else ran";
}

// several iterations -> else skipped
print "T2";
var j = 0;
while (j < 3) {
  print j;
  j = j + 1;
} else {
  print "BAD else";
}

// exactly one iteration -> else skipped
print "T3";
var once = true;
while (once) {
  print "body once";
  once = false;
} else {
  print "BAD else";
}

// no else clause at all (zero and nonzero iterations)
print "T4";
while (false) print "BAD";
var n4 = 0;
while (n4 < 2) n4 = n4 + 1;
print n4;

// hidden local must not disturb other locals in a block
print "T5";
{
  var a = "a";
  var n = 0;
  while (n < 2) {
    n = n + 1;
  } else {
    print "BAD else";
  }
  var b = "b";
  print a;
  print b;
  print n;
}

// nested loops
// inner else executes only when inner body never runs
print "T6";
var x = 0;
while (x < 3) {
  var y = 0;
  while (y < x) {
    y = y + 1;
  } else {
    print "inner empty at:";
    print x;
  }
  x = x + 1;
}

// single statements instead of blocks
print "T7";
while (false) print "BAD"; else print "b";

// dangling else binds to the while, not the if
print "T8";
if (true) while (false) print "x"; else print "bound to while";
if (false) while (false) print "x"; else print "BAD";  // prints nothing

// for loop inside a while body with else
print "T9";
var k = 0;
while (k < 2) {
  for (var m = 0; m < 2; m = m + 1) print m;
  k = k + 1;
} else {
  print "BAD else";
}

// while/else nested inside an else branch
print "T10";
while (false) {
  print "BAD";
} else {
  while (false) {
    print "BAD";
  } else {
    print "nested else";
  }
}