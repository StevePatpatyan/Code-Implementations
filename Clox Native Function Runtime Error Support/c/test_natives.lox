fun check(name, actual, expected) {
  if (actual == expected) print name + ": ok";
  else print name + ": FAIL";
}

// floor
check("floor 3.7",   floor(3.7),  3);
check("floor -3.2",  floor(-3.2), -4);
check("floor 5",     floor(5),    5);

// mod
check("mod 7 3",     mod(7, 3),    1);
check("mod 6 3",     mod(6, 3),    0);
check("mod 7.5 2",   mod(7.5, 2),  1.5);
check("mod -7 3",    mod(-7, 3),  -1);   // fmod keeps the sign of the dividend

// len
check("len hello",   len("hello"), 5);
check("len empty",   len(""),      0);

// substr
check("substr mid",   substr("hello", 1, 3), "el");
check("substr full",  substr("hello", 0, 5), "hello");
check("substr empty", substr("hello", 2, 2), "");

// str
check("str int",     str(3),    "3");
check("str frac",    str(1.5),  "1.5");
check("str neg",     str(-0.25), "-0.25");

// num
check("num int",     num("42"),   42);
check("num frac",    num("3.5"),  3.5);
check("num neg",     num("-2"),  -2);

// round trip (which is converting a num to a str and back)
check("round trip",  num(str(123.25)), 123.25);